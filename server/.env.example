# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env ขึ้น Git)

# PostgreSQL ออนไลน์ (Neon / Supabase)
# DATABASE_URL = connection string ที่แอปใช้ตอนรัน (ใช้แบบ pooled ได้)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# DIRECT_URL = connection string แบบตรง ใช้ตอน prisma migrate (ถ้าใช้ Neon ใส่ค่าเดียวกับ DATABASE_URL ได้)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

PORT=3000
# origin ของหน้าเว็บ React ที่อนุญาตให้เรียก API (คั่นด้วย , ได้หลายค่า)
CLIENT_ORIGIN="http://localhost:5173"
