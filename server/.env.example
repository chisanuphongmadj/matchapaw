# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env ขึ้น Git)

# ---------- ฐานข้อมูล (จำเป็น) ----------
# Supabase: Connect > Connection String > Session pooler (พอร์ต 5432) ใส่ค่าเดียวกันทั้งสองบรรทัด
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres"

# ---------- ล็อกอิน (จำเป็นตอน deploy) ----------
# สุ่มข้อความยาว ๆ ที่เดาไม่ได้ เช่น รัน: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="ใส่ข้อความลับยาวๆ"

PORT=3000
# origin ของหน้าเว็บ React ที่อนุญาตให้เรียก API (คั่นด้วย , ได้หลายค่า) และใช้สร้างลิงก์ในอีเมล
CLIENT_ORIGIN="http://localhost:5173"

# ---------- อัปโหลดรูป (ไม่บังคับ) ----------
# Supabase: Project Settings > API (Project URL และ service_role key) ห้ามใส่ key นี้ในฝั่ง client เด็ดขาด
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="pet-images"

# ---------- อีเมลแจ้งเตือน (ไม่บังคับ) ----------
# Resend: resend.com > API Keys (บัญชีฟรีที่ยังไม่ยืนยันโดเมน ส่งได้เฉพาะอีเมลเจ้าของบัญชี)
RESEND_API_KEY=""
EMAIL_FROM="MatchAPaw <onboarding@resend.dev>"
